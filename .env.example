# mise がこのファイルを環境変数として読む。リポジトリには置かない。
# Google のクライアント ID とシークレットは infra/terraform/terraform.tfvars に書く。

# Cloudflare の API トークン。Workers Scripts、Workers R2 Storage、Access の Apps and Policies、Access の Organizations, Identity Providers, and Groups。
CLOUDFLARE_API_TOKEN=

# ダッシュボードの R2 > Manage R2 API Tokens で作った S3 互換キー。
# Object Read & Write を photogallery-media に付ける。Terraform の API トークンとは別。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=photogallery-media
