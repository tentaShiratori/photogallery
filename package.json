{
  "name": "photogallery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "upload:local": "node --experimental-strip-types scripts/upload-local.ts",
    "upload:prd": "node --experimental-strip-types scripts/upload-prd.ts",
    "test": "vp test",
    "e2e": "e2e run",
    "e2e:update-screenshots": "node --experimental-strip-types scripts/e2e-update-screenshots.ts",
    "deadcode": "fallow dead-code --fail-on-issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@e2e-dev/web": "^0.15.3",
    "@types/node": "^26.6.5",
    "e2e": "^0.21.3",
    "fallow": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vite-ssr-components": "^0.9.0",
    "vitest": "catalog:",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@12.14.0"
}
