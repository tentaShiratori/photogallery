{
  "name": "photogallery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp fmt --check && vp lint && pnpm deadcode && pnpm typecheck && pnpm test run --coverage",
    "upload:local": "node --experimental-strip-types scripts/upload-local.ts",
    "upload:prd": "node --experimental-strip-types scripts/upload-prd.ts",
    "perf": "node --experimental-strip-types scripts/perf.ts",
    "perf:year-list": "node --experimental-strip-types scripts/perf-year-list.ts",
    "seed:perf": "node --experimental-strip-types scripts/seed-perf-year-list.ts",
    "test": "vp test",
    "coverage": "vp test run --coverage",
    "e2e": "e2e run",
    "e2e:update-screenshots": "node --experimental-strip-types scripts/e2e-update-screenshots.ts",
    "deadcode": "fallow dead-code --fail-on-issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@t3-oss/env-core": "^0.13.11",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.14",
    "sharp": "^0.35.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@e2e-dev/web": "^0.15.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-launcher": "^1.2.2",
    "e2e": "^0.21.3",
    "fallow": "^3.36.0",
    "happy-dom": "^21.0.4",
    "lighthouse": "^13.6.0",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vite-ssr-components": "^0.9.0",
    "vitest": "catalog:",
    "web-vitals": "^6.2.3",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@12.14.0"
}
