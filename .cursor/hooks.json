{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/fmt-lint.mjs",
        "timeout": 120,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/check.mjs",
        "timeout": 600,
        "loop_limit": 5
      }
    ]
  }
}
