{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photogallery",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "photogallery-media"
    }
  ]
}
