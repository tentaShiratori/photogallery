{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photogallery",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist/static",
    "binding": "ASSETS",
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "photogallery-media",
    },
  ],
}
